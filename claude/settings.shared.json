{
  "disableWorkflows": true,
  "enabledPlugins": {
    "compound-engineering@compound-engineering-plugin": true
  },
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "source": {
        "repo": "EveryInc/compound-engineering-plugin",
        "source": "github"
      }
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/context-nudge.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/context-nudge.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/context-nudge.sh",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Artifact"
    ]
  },
  "statusLine": {
    "command": "$HOME/.claude/statusline.sh",
    "type": "command"
  }
}
