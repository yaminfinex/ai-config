#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)/lib/common.sh"

quick=0
strict=0

for arg in "$@"; do
  case "$arg" in
    --quick) quick=1 ;;
    --strict) strict=1 ;;
    -h|--help)
      cat <<'USAGE'
Usage: ai-doctor [--quick] [--strict]

Checks ai-config repository health, link drift, local-only skills, secrets,
machine-specific absolute home paths, Claude config divergence, and Grok
credential/home/PATH-resolution drift. It also verifies that a fresh login
shell defines the claude/codex/grok launcher functions (lib/launchers.sh via
the ai-setup rc block) and resolves the herder/mish bin wrappers to
this checkout, flags mise-owned duplicate vendor CLIs (npm copies inside node
installs), and warns when the current shell carries managed-agent identity
that makes direct vendor CLI probes unsafe. Findings are reported only; Grok
state is never repaired automatically.

--quick skips network freshness checks. --strict fails on repository-health
warnings; the situational identity-bearing-shell nudge remains warning-tier rc 0.
USAGE
      exit 0
      ;;
    *)
      log_error "unknown argument: $arg"
      exit 2
      ;;
  esac
done

errors=0
warnings=0
strict_exempt_warnings=0

warn() {
  warnings=$((warnings + 1))
  log_warn "$*"
}

warn_strict_exempt() {
  warnings=$((warnings + 1))
  strict_exempt_warnings=$((strict_exempt_warnings + 1))
  log_warn "$*"
}

err() {
  errors=$((errors + 1))
  log_error "$*"
}

check_git() {
  local branch_status
  local upstream

  if ! git -C "$AI_CONFIG_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    err "$AI_CONFIG_ROOT is not a Git repository"
    return
  fi

  branch_status="$(git -C "$AI_CONFIG_ROOT" status --short --branch)"
  printf '%s\n' "$branch_status"

  if git_dirty; then
    warn "working tree has uncommitted changes"
  fi

  if ! upstream="$(git -C "$AI_CONFIG_ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)"; then
    warn "current branch has no upstream remote"
  else
    log_info "upstream: $upstream"
  fi
}

check_portable_links() {
  local spec
  local src_rel
  local dst
  local src

  while IFS= read -r spec; do
    src_rel="${spec%%|*}"
    dst="${spec#*|}"
    src="$AI_CONFIG_ROOT/$src_rel"

    [ -e "$src" ] || continue

    if [ -L "$dst" ]; then
      if symlink_points_to "$dst" "$src"; then
        [ "$quick" -eq 1 ] || log_info "link ok: $dst"
      else
        warn "link points elsewhere: $dst -> $(readlink "$dst")"
      fi
    elif [ -e "$dst" ]; then
      warn "collision: $dst exists and is not a symlink"
    else
      warn "missing link: $dst -> $src"
    fi
  done < <(portable_link_specs)
}

check_skill_links() {
  local spec
  local agent
  local config_home
  local root
  local skill
  local src
  local dst

  while IFS='|' read -r agent config_home root; do
    [ -d "$config_home" ] || continue

    while IFS= read -r skill; do
      src="$AI_CONFIG_ROOT/skills/$skill"
      dst="$root/$skill"

      if [ -L "$dst" ]; then
        if symlink_points_to "$dst" "$src"; then
          [ "$quick" -eq 1 ] || log_info "skill link ok: $agent:$skill"
        else
          warn "skill link points elsewhere: $dst -> $(readlink "$dst")"
        fi
      elif [ -e "$dst" ]; then
        warn "skill collision: $dst exists and is not a symlink"
      else
        warn "missing skill link: $dst -> $src"
      fi
    done < <(repo_skill_names)
  done < <(skill_root_specs)
}

check_unharvested_live_skills() {
  local spec
  local agent
  local config_home
  local root
  local child
  local name
  local real_child
  local seen_children=()
  local seen_child
  local already_seen

  while IFS='|' read -r agent config_home root; do
    [ -d "$root" ] || continue

    while IFS= read -r child; do
      real_child="$(abs_path "$child")"
      already_seen=0
      if [ "${#seen_children[@]}" -gt 0 ]; then
        for seen_child in "${seen_children[@]}"; do
          if [ "$seen_child" = "$real_child" ]; then
            already_seen=1
            break
          fi
        done
      fi

      [ "$already_seen" -eq 1 ] && continue
      seen_children+=("$real_child")

      name="$(basename "$child")"
      case "$agent:$name" in
        project-*:ai-config-bootstrap) continue ;;
      esac

      is_ignored_live_skill_name "$name" && continue
      repo_skill_exists "$name" && continue
      [ -f "$child/SKILL.md" ] || continue

      warn "unharvested local skill in $agent: $child"
    done < <(find "$root" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -print 2>/dev/null)
  done < <(
    skill_root_specs
    project_skill_root_specs
  )
}

check_secret_scan() {
  local paths=()
  local findings

  while IFS= read -r path; do
    paths+=("$path")
  done < <(existing_scan_paths "${PORTABLE_SCAN_PATHS[@]}")

  findings="$(scan_secret_regex_paths "${paths[@]}")"
  if [ -n "$findings" ]; then
    err "possible secret found:"
    printf '%s\n' "$findings" >&2
  fi
}

print_statusline_snippet() {
  cat >&2 <<'SNIPPET'
  merge this into ~/.claude/settings.json:
    "statusLine": {
      "command": "$HOME/.claude/statusline.sh",
      "type": "command"
    }
SNIPPET
}

check_claude_statusline_settings() {
  local settings="$HOME/.claude/settings.json"
  local expected="$HOME/.claude/statusline.sh"
  local command

  [ -f "$settings" ] || {
    warn "claude settings missing: $settings"
    print_statusline_snippet
    return
  }

  if ! command -v jq >/dev/null 2>&1; then
    warn "jq not installed; skipping statusLine check in $settings"
    return
  fi

  command="$(jq -r '.statusLine.command // ""' "$settings" 2>/dev/null)"

  case "$command" in
    "")
      warn "statusLine.command not set in $settings"
      print_statusline_snippet
      ;;
    "$expected"|'$HOME/.claude/statusline.sh'|"~/.claude/statusline.sh")
      [ "$quick" -eq 1 ] || log_info "statusLine ok: $command"
      ;;
    *)
      warn "statusLine.command in $settings points elsewhere: $command (expected $expected)"
      print_statusline_snippet
      ;;
  esac
}

check_claude_shared_settings() {
  local shared="$AI_CONFIG_ROOT/claude/settings.shared.json"

  [ -f "$shared" ] || return 0

  if ! command -v jq >/dev/null 2>&1; then
    warn "jq not installed; skipping shared settings check"
    return
  fi

  source "$AI_CONFIG_ROOT/lib/claude-settings.sh"

  jq -e . "$shared" >/dev/null 2>&1 || {
    err "shared settings fragment is not valid JSON: $shared"
    return
  }

  claude_settings_live_valid || {
    warn "live claude settings are not valid JSON: $CLAUDE_SETTINGS_LIVE"
    return
  }

  if claude_settings_in_sync; then
    [ "$quick" -eq 1 ] || log_info "claude shared settings ok: $CLAUDE_SETTINGS_LIVE"
  else
    warn "claude settings missing shared fragment keys; run bin/ai-setup"
  fi
}

print_claude_config_divergence_options() {
  cat >&2 <<'OPTIONS'
  pinned non-default-bus claude sessions read ~/.claude/.claude.json; plain sessions
  read ~/.claude.json — while they differ the two run with different
  identity/config state. Your call (ai-doctor never fixes this itself):
    re-align: cp ~/.claude.json ~/.claude/.claude.json
    delete:   rm ~/.claude/.claude.json    # safe: next pinned launch re-seeds it
OPTIONS
}

check_claude_config_divergence() {
  local base="$HOME/.claude.json"
  local pinned="$HOME/.claude/.claude.json"

  [ -f "$base" ] || return 0
  [ -f "$pinned" ] || return 0

  if cmp -s "$base" "$pinned"; then
    [ "$quick" -eq 1 ] || log_info "claude config copies identical: $pinned"
    return 0
  fi

  warn "claude config divergence: $pinned differs from $base"
  print_claude_config_divergence_options
}

check_portability_scan() {
  local paths=()
  local findings

  while IFS= read -r path; do
    paths+=("$path")
  done < <(existing_scan_paths "${PORTABLE_SCAN_PATHS[@]}")

  findings="$(scan_portability_paths "${paths[@]}")"
  if [ -n "$findings" ]; then
    err "absolute home path found in portable file:"
    printf '%s\n' "$findings" >&2
  fi
}

check_mise_path() {
  source "$AI_CONFIG_ROOT/lib/mise-path.sh"

  local file
  local bin_dir
  local shims_dir
  local configured
  local count
  local tool
  local expected
  local resolution

  if mise_available; then
    [ "$quick" -eq 1 ] || log_info "mise present"
  else
    err "mise is required; install mise, then run bin/ai-setup"
    return
  fi

  file="$(mise_path_config_file)"
  bin_dir="$(mise_bin_dir)"
  shims_dir="$(mise_shims_dir)"

  if [ ! -e "$file" ]; then
    warn "ai-config mise PATH config missing; run bin/ai-setup"
    return
  fi

  if ! mise_file_is_ours "$file"; then
    warn "ai-config mise PATH config exists but is not managed by ai-config: $file"
    return
  fi

  configured="$(mise_configured_paths "$file" || true)"
  if ! printf '%s\n' "$configured" | grep -Fqx "$bin_dir"; then
    warn "ai-config mise PATH config missing bin dir: $bin_dir"
  fi
  # The previous generation also fronted the herder shims dir globally; that
  # interception is now launcher shell functions (lib/launchers.sh), so a
  # leftover global shims entry means the machine has not re-run ai-setup.
  if printf '%s\n' "$configured" | grep -Fqx "$shims_dir"; then
    warn "ai-config mise PATH config still fronts the herder shims dir globally ($shims_dir); rerun bin/ai-setup — interception moved to launcher functions"
  fi

  count="$(mise_path_count "$bin_dir")"
  if [ "$count" != "1" ]; then
    warn "ai-config bin dir should appear on PATH exactly once; found $count: $bin_dir"
  fi

  expected="$bin_dir/herder"
  resolution="$(mise_tool_resolution_message herder "$expected")"
  case "$resolution" in
    "herder: expected first") [ "$quick" -eq 1 ] || log_info "$resolution" ;;
    *) warn "$resolution" ;;
  esac
}

check_vendor_agent_duplicates() {
  # Vendor CLIs must exist exactly once, outside mise: an npm `claude`/`codex`
  # inside a mise-managed node install is what a shadowing mise shim
  # dispatches to — the raw off-bus launch. The launcher functions make the
  # interactive path immune, but `command claude`, scripts, and hcom's PATH
  # fallback on unpinned machines still lose to these copies.
  local data_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"
  local tool copy real seen
  [ -d "$data_dir/installs" ] || return 0
  for tool in claude codex; do
    seen=""
    while IFS= read -r copy; do
      real="$(abs_path "$copy")"
      case "$seen" in *"|$real|"*) continue ;; esac
      seen="$seen|$real|"
      warn "mise-owned copy of $tool shadows the vendor CLI: $copy — remove it (for npm copies: npm -g uninstall inside that node install, then 'mise reshim')"
    done < <(find "$data_dir/installs" -maxdepth 4 \( -type f -o -type l \) -path "*/bin/$tool" 2>/dev/null)
  done
}

check_retired_vendor_pin_cache() {
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/herder/vendorbin"
  [ -d "$cache_dir" ] || return 0
  warn "orphaned retired herder vendor pin cache: $cache_dir; stale entries are ignored and degrade safely, but nothing maintains or prunes this directory after the launcher rewire"
}

resolve_in_login_shell() {
  # Run one command in a fresh login+interactive shell and echo its stdout.
  # -l sources the login profile, -i the interactive rc — together they mirror
  # what a hand-typed command sees.
  #
  # An interactive bash enables job control and reaches for the controlling
  # terminal (tcsetpgrp via /dev/tty). Spawned from ai-doctor under a real tty it
  # loses that race, takes SIGTTOU, and STOPS (state T). A stopped child ignores
  # timeout's default SIGTERM (it only pends until SIGCONT), so plain `timeout 8`
  # blocks forever in wait() — the classic pair of hung processes. setsid gives
  # the child its own session with NO controlling terminal, so job control finds
  # nothing to grab and never stops; </dev/null keeps it off the tty for input;
  # `timeout -k` is the belt-and-braces hard kill (SIGKILL fells even a stopped
  # process) for anything else an rc might block on. stderr is dropped (an
  # interactive shell without a tty emits job-control noise).
  local shell="$1" cmd="$2"
  local runner=("$shell" -lic "$cmd")
  if command -v timeout >/dev/null 2>&1; then
    runner=(timeout -k 2 8 "${runner[@]}")
  fi
  if command -v setsid >/dev/null 2>&1; then
    setsid "${runner[@]}" </dev/null 2>/dev/null || true
  else
    "${runner[@]}" </dev/null 2>/dev/null || true
  fi
}

check_login_shell_resolution() {
  # check_mise_path inspects THIS process's state, which a herder seat (or any
  # already-repaired shell) has corrected — so it can pass while a plain login
  # terminal still misroutes a hand-typed command. Two contracts, probed in a
  # fresh login+interactive shell exactly as a hand-typed lookup would run:
  #   1. claude/codex/grok are LAUNCHER FUNCTIONS (lib/launchers.sh via the
  #      ai-setup rc block). Functions win over every PATH entry, so this is
  #      immune to mise hook-env re-fronting its shims dir on cd — the reason
  #      the PATH-shim generation of this design was retired.
  #   2. herder/mish bin/ wrappers resolve to THIS checkout, not a
  #      stale copy (e.g. a `go install` leftover or a mise shim).
  source "$AI_CONFIG_ROOT/lib/mise-path.sh"

  local bin_dir login_shell tool expected resolved kind probe_cmd out

  login_shell="${SHELL:-}"
  if [ ! -x "$login_shell" ]; then
    login_shell="$(getent passwd "$(id -un 2>/dev/null)" 2>/dev/null | cut -d: -f7 || true)"
  fi
  [ -x "$login_shell" ] || login_shell="/bin/bash"
  case "$login_shell" in
    *bash|*zsh) ;;
    *)
      [ "$quick" -eq 1 ] || log_info "login-shell resolution check skipped: unsupported login shell ($login_shell)"
      return 0
      ;;
  esac

  bin_dir="$(mise_bin_dir)"

  # `typeset -f` detects functions in both bash and zsh; `command -v` reports
  # the PATH answer for what would actually run when it is not a function.
  # Sentinel lines isolate answers from any rc banner on stdout.
  probe_cmd='for _t in claude codex grok; do if typeset -f "$_t" >/dev/null 2>&1; then printf "AIDOCTOR_KIND %s=function\n" "$_t"; else printf "AIDOCTOR_KIND %s=%s\n" "$_t" "$(command -v "$_t" 2>/dev/null || true)"; fi; done; for _t in herder mish; do printf "AIDOCTOR_BIN %s=%s\n" "$_t" "$(command -v "$_t" 2>/dev/null || true)"; done'
  out="$(resolve_in_login_shell "$login_shell" "$probe_cmd")"

  if [ -z "$out" ]; then
    warn "login-shell resolution check could not probe $login_shell (no output); verify the rc files by hand"
    return 0
  fi

  for tool in claude codex grok; do
    kind="$(printf '%s\n' "$out" | sed -n "s/^AIDOCTOR_KIND $tool=//p" | tail -n1)"
    if [ "$kind" = "function" ]; then
      [ "$quick" -eq 1 ] || log_info "login shell defines the $tool launcher function"
    elif [ -z "$kind" ]; then
      [ "$quick" -eq 1 ] || log_info "login shell has no '$tool' at all (vendor CLI not installed; launcher function absent)"
    else
      warn "login shell resolves '$tool' to $kind instead of the launcher function; a hand-typed $tool launches raw (off-bus, no autonomous flags). Run bin/ai-setup to install the rc block (bin/ai-setup --rc status to inspect)."
    fi
  done

  for tool in herder mish; do
    expected="$bin_dir/$tool"
    resolved="$(printf '%s\n' "$out" | sed -n "s/^AIDOCTOR_BIN $tool=//p" | tail -n1)"
    [ -n "$resolved" ] || continue   # not on PATH here — nothing to shadow
    if [ "$resolved" = "$expected" ]; then
      [ "$quick" -eq 1 ] || log_info "login shell resolves $tool to the ai-config checkout"
    else
      warn "login shell resolves '$tool' to $resolved, not the ai-config checkout ($expected); a PATH entry ahead of the ai-config bin dir — usually ~/.local/share/mise/shims or a stale install — shadows it"
    fi
  done
}

check_grok_family() {
  source "$AI_CONFIG_ROOT/lib/grok-health.sh"

  local configured_home="${GROK_HOME:-}"
  local vendor_binary

  if [ -z "${XAI_API_KEY:-}" ]; then
    warn "Grok credential precondition missing: XAI_API_KEY is absent or empty in this environment; export it from a login-shell profile such as \$HOME/.profile, then verify in a fresh herder pane"
  fi

  if [ -n "$configured_home" ]; then
    warn "GROK_HOME is set to $configured_home, but herder launches deliberately unset it so Grok uses the vendor default $HOME/.grok"
  fi

  vendor_binary="$(grok_vendor_on_path || true)"
  if [ -z "$vendor_binary" ]; then
    warn "no Grok vendor binary found on PATH after retired herder shims; install Grok Build before launch"
  else
    [ "$quick" -eq 1 ] || log_info "Grok vendor binary resolved past retired herder PATH shims (not executed): $vendor_binary"
  fi
}

check_identity_bearing_shell() {
  local key
  local present=()

  for key in HCOM_PROCESS_ID HCOM_INSTANCE_NAME HCOM_SESSION_ID HERDER_GUID HERDR_PANE_ID; do
    if [ -n "${!key:-}" ]; then
      present+=("$key")
    fi
  done
  [ "${#present[@]}" -gt 0 ] || return 0

  # This is a situational launch-safety nudge, not repository health. Managed
  # agent shells carry these values by design, so --strict must not make every
  # doctor run inside a seat permanently red.
  warn_strict_exempt "current shell carries managed-agent identity (${present[*]}); launch agents from a clean shell through the managed launcher functions, or run probes under env -i with an isolated HOME/state and no HCOM_*/HERDER_*/HERDR_* values"
}

check_git
check_portable_links
check_skill_links
check_unharvested_live_skills
check_claude_statusline_settings
check_claude_shared_settings
check_claude_config_divergence
check_mise_path
check_vendor_agent_duplicates
check_retired_vendor_pin_cache
check_login_shell_resolution
check_grok_family
check_identity_bearing_shell
check_secret_scan
check_portability_scan

if [ "$errors" -gt 0 ]; then
  log_error "ai-doctor found $errors error(s) and $warnings warning(s)"
  exit 1
fi

if [ "$warnings" -gt 0 ]; then
  log_warn "ai-doctor found $warnings warning(s)"
  [ "$strict" -eq 1 ] && [ "$warnings" -gt "$strict_exempt_warnings" ] && exit 1
  exit 0
fi

log_info "ai-doctor ok"
