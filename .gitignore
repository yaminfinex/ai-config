# Machine-local secrets and auth
*.local.json
.credentials.json
auth.json

# Agent runtime state
history.jsonl
sessions/
cache/
telemetry/
logs/
*.log

# Databases and transient state
*.sqlite
*.sqlite-*
*.db
*.db-*

# Legacy per-branch scratch (skill retired in favor of skills/using-missions); still ignored
# so existing local napkins/ content stays out of git until migrated to a mission
napkins/

# Local backups and generated files
backups/
.ai-config-backup/
.DS_Store

# Vendored project build artifacts
vendor/*/node_modules/
vendor/*/dist/
vendor/*/coverage/

# hcom worktree-local bus state
.hcom/

# Grok project-scope runtime config for herder-owned seat worktrees
.grok/

# claude runtime cruft from isolated CLAUDE_CONFIG_DIR spikes
.agents/plugins/
.agents/projects/
.agents/*.json
.agents/scheduled_tasks.lock

.mission
