# herder native — build, gates, harness, bundle. See ARCHITECTURE.md.

# rustup's toolchain (rust-toolchain.toml), not Homebrew's cargo, which can't build gpui-pre.
export PATH := env_var("HOME") + "/.cargo/bin:" + env_var("PATH")

_default:
    @just --list

# The three code gates.
check:
    cargo fmt --check
    cargo clippy --all-targets -- -D warnings
    cargo test

fmt:
    cargo fmt

build:
    cargo build --release

# Run the app from the terminal (HERDER_URL overrides the server).
run *args: build
    ./target/release/herder-native {{args}}

# Scripted run that never takes focus: `just harness "wait:800 shot:lens rss quit"`.
# Screenshots land in shots/ and need the `shots` feature (GPUI test-support). Exits non-zero on a failed step.
harness script:
    cargo build --release --features shots
    mkdir -p shots
    HERDER_NATIVE_SCRIPT="{{script}}" HERDER_NATIVE_SHOT_DIR=shots ./target/release/herder-native

# Key scenario (A0): cmd-= through the real input path must reach TextBigger and persist 1.1.
# Runs against a throwaway HOME so the owner's prefs are untouched. Then (DK2) the dock's chords typed
# in the composer change nothing.
check-keys: build
    #!/usr/bin/env bash
    set -eu
    home=$(mktemp -d)
    HOME="$home" HERDER_NATIVE_SCRIPT="wait:300 key:cmd-= wait:400 quit" ./target/release/herder-native
    prefs="$home/Library/Application Support/herder-native/prefs.json"
    grep -q '"text_scale": 1.1' "$prefs" || { echo "check-keys: text_scale not persisted"; exit 1; }
    rm -rf "$home"
    # The dock's chords (DK2) never fire in the composer: the box keeps its text, the dock its tabs, and
    # nothing is written (fake serve).
    . scripts/scenario.sh check-keys
    dock="dock:mupu*+support-mifa+|+[conductor-line*~]"
    scenario chords "" "wait:1500 key:enter wait:400 draw key:] wait:600 draw beside:herder-agent:conductor-line wait:800 draw $dock key:/ draw key:x tap:cmd-w tap:cmd-1 tap:cmd-9 tap:alt-left tap:alt-right draw box:focused:x $dock quit"
    # Nothing written but the read markers' seeds (RM).
    seen chords "POST /api/agents\|POST /api/state/spaces\|POST /api/state/notes" 0
    echo "check-keys: ok (text_scale 1.1 persisted; cmd-w, cmd-1…9 and alt-left/right do nothing to the dock from the composer)"

# Composer scenarios (U4), each through `scripts/scenario.sh` (fake serve, own HOME, must reach `quit`) and
# with exactly the POSTs it expects:
# keys    focus the box, type keys the lens and zoom bind (they land as text), cmd-enter sends once and
#         clears the draft, escape leaves the box but not the zoom;
# held    a held send shows "sending" and swallows a second cmd-enter;
# drafts  drafts A -> B -> A across tabs and spaces; a path or same-agent link keeps the box focused, another
#         agent's link gives focus to the zoom (no send);
# failed  cmd-shift-enter on a preview (which pins it, DK2) answered 502 stays on it, saying why;
# fileback cmd-shift-enter stays "sending" until the (slow) send lands, then leaves for the lens, which
#         takes focus even though escape moved it from the box to the zoom meanwhile (enter zooms in);
# collide a 409 sender collision makes every box read-only.
check-composer:
    #!/usr/bin/env bash
    . scripts/scenario.sh check-composer
    zoom="wait:1500 key:enter wait:400 draw link:herder-agent:mupu wait:1500 draw expect:mupu+preview"
    typed="$zoom key:/ draw key:h key:i draw"
    run() { # MODE NAME POSTS SCRIPT
        scenario "$2" "--message $1" "$4"
        seen "$2" "message to" "$3"
    }
    run ok keys 1 "$zoom key:/ draw box:focused: key:n key:j key:[ key:] key:1 key:v key:? draw box:focused:nj[]1v? expect:mupu+preview shot:u4-draft key:cmd-enter wait:800 draw box:focused: shot:u4-empty key:escape draw box:idle: expect:mupu quit"
    run hold held 1 "$typed key:cmd-enter wait:400 draw says:sending shot:u4-sending key:x key:cmd-enter wait:300 draw box:focused:hi quit"
    run ok drafts 0 "wait:1500 key:enter wait:400 draw expect:chief-mihe key:/ draw key:a draw box:focused:a key:escape draw box:idle:a key:] wait:600 draw expect:mupu box:idle: key:tab wait:300 draw expect:support-mifa key:/ draw key:b draw box:focused:b key:escape key:shift-tab wait:300 draw expect:mupu box:idle: key:tab draw expect:support-mifa box:idle:b key:[ wait:600 draw expect:chief-mihe box:idle:a key:/ draw link:herder-path:src/main.rs wait:400 draw box:focused:a link:herder-agent:chief-mihe draw box:focused:a link:herder-agent:mupu wait:400 draw expect:mupu+preview box:idle: key:/ draw box:focused: quit"
    run 502 failed 1 "$typed key:cmd-shift-enter wait:600 draw expect:mupu box:focused:hi says:unreachable,+not+sent shot:u4-fileback-failed quit"
    run slow fileback 1 "$typed key:cmd-shift-enter wait:300 draw expect:mupu says:sending key:escape draw box:idle:hi wait:1500 draw expect: box:idle: key:enter wait:600 draw expect:chief-mihe quit"
    run 409 collide 1 "$typed key:cmd-enter wait:600 draw box:focused:hi says:sender+collision shot:u4-collision key:escape link:herder-agent:chief-mihe wait:400 draw says:read-only quit"
    echo "check-composer: ok (keys typed, one send each, held send not repeated, drafts per agent, link focus, file-back on success only, collision read-only)"

# Notes scenarios (U5), each through `scripts/scenario.sh`, so no note reaches the real serve (web would show
# it), with exactly the notes POSTs it expects and no message sent; a second script relaunches on the same
# HOME and fake serve:
# empty    the strip of an agent without notes is not drawn;
# editor   web's two notes on mupu; `a` opens the editor, the lens, zoom and composer keys type there, and
#          neither alt-enter nor cmd-shift-enter sends or queues anything; an empty save is refused with the
#          editor kept; cmd-enter saves the note;
# edit     a click on a note edits it (emptied, the save is refused and the editor stays), enter saves and
#          leaves the editor; a second click on its ✕ deletes it;
# capture  (F7) a real drag over mupu's answer puts the focused "＋ Add note" chip under it; it is gone once the
#          zoom moves to chief-mihe (and back); dragged again, a typed `o` opens the popover with it typed, `k`
#          follows, enter saves one note with the quote (one POST, the quote in it);
# dropped  a letter on the chip types (k opens the popover, nothing scrolls); esc closes it and keeps nothing,
#          then the zoom's keys work again (k scrolls); a click elsewhere closes a chip; a drag let go over
#          the composer still gets one (j types); nothing is written;
# sent     cmd-enter in the popover sends web's note text (source, quote, comment) to mupu: one message, no
#          note, the draft untouched;
# handoff  `p` moves both notes into mupu's composer draft (web's hand-off text) and deletes them; after a
#          relaunch the draft holds them and the notes stay deleted;
# queue    alt-enter in the composer keeps its draft as a note and clears the box;
# list     (F6) `up` from the empty box enters the list with both selected; up/down move, shift extends,
#          cmd-a selects all; no lens, zoom or composer key fires there (letters included); escape clears,
#          then leaves for the box; `up` in a box with text moves the caret, emptied it enters again;
# picked   clicks pick (cmd toggles, shift a range); enter hands only the selected note into the draft and
#          deletes only it once the draft is saved, the other then selected; a relaunch keeps it;
# keyed    backspace arms the selection's delete (a move disarms it), a second deletes it and the cursor
#          lands on the note before; `e` edits the cursor's note in place, enter saves back into the
#          list; cmd-c copies it (logged, never the owner's clipboard);
# armed    cmd-c, or an unbound letter, between two backspaces disarms the first: the second only arms again,
#          and nothing is deleted; `e` edits the cursor's note when a cmd-click took it out of the selection.
check-notes:
    #!/usr/bin/env bash
    . scripts/scenario.sh check-notes
    zoom="wait:1500 key:enter wait:400 draw link:herder-agent:mupu wait:1500 draw expect:mupu+preview"
    run() { # NOTES NAME POSTS SCRIPT [RELAUNCH-SCRIPT]
        scenario "$2" "$1" "$4" ${5:+"$5"}
        seen "$2" "state notes:" "$3"
        seen "$2" "message to" 0
    }
    run "" empty 0 "$zoom notes:0:closed shot:u5-empty quit"
    run --notes editor 1 "$zoom notes:2:closed shot:u5-notes key:a draw notes:2:focused: key:enter draw notes:2:focused: key:n key:j key:[ key:] key:a key:c key:p key:/ draw notes:2:focused:nj[]acp/ tap:alt-enter tap:cmd-shift-enter draw box:idle: notes:2:focused:nj[]acp/ shot:u5-editing key:cmd-enter wait:800 draw notes:3:closed box:idle: quit"
    run --notes edit 2 "$zoom click:edit:0 draw notes:2:focused:check+the+outbox+after+a+409 key:cmd-a key:backspace draw notes:2:focused: key:enter draw notes:2:focused: shot:u5-refused key:o key:k key:enter wait:800 draw notes:2:closed box:idle: click:delete:1 draw notes:2:closed shot:u5-delete click:delete:1 wait:800 draw notes:1:closed quit"
    drag="drag:30,210,250,210 draw" # across the first line of mupu's last-but-one answer, at the tail
    capture="$zoom $drag capture:chip:focused:Everything+in+this+window shot:f7-chip link:herder-agent:chief-mihe wait:600 draw capture:none"
    capture+=" link:herder-agent:mupu wait:1500 draw expect:mupu+preview capture:none $drag key:o draw key:k draw capture:open:focused:ok shot:f7-popover"
    run --notes capture 1 "$capture key:enter wait:800 draw notes:3:closed capture:none said:Saved. box:idle: quit"
    grep -q 'state notes: .*Everything in this window has been h' "$home/capture.fake" || { echo "check-notes: capture: no quote posted"; exit 1; }
    dropped="$zoom $drag key:k draw capture:open:focused:k jump:hidden key:escape draw capture:none notes:2:closed jump:hidden"
    dropped+=" key:k draw jump:shown key:shift-g draw $drag capture:chip:focused point:600,60 draw capture:none"
    dropped+=" drag:30,210,250,800 draw capture:chip:focused key:j draw capture:open:focused:j key:escape draw capture:none" # let go over the composer
    run --notes dropped 0 "$dropped quit"
    scenario sent --notes "$zoom $drag key:o draw key:k draw key:cmd-enter wait:800 draw capture:none notes:2:closed said:Sending+a+note+to+mupu box:idle: quit"
    seen sent "state notes:" 0
    seen sent "message to mupu: {.text.:.from mupu's transcript:.*n> Everything in this window has been h.*nok.}" 1
    run --notes handoff 1 "$zoom key:p wait:800 draw notes:0:closed has:from+mupu's+transcript: has:check+the+outbox+after+a+409 shot:u5-handoff quit" "$zoom notes:0:closed has:from+mupu's+transcript: has:check+the+outbox+after+a+409 quit"
    run "" queue 1 "$zoom key:/ draw key:h key:i draw box:focused:hi key:alt-enter wait:800 draw box:focused: notes:1:closed shot:u5-queued quit"
    up="$zoom key:/ draw key:up draw"
    list="$up list:focused:0,1@0 shot:f6-list key:down list:focused:1@1 key:shift-up list:focused:0,1@0 key:down key:cmd-a draw list:focused:0,1@1"
    list+=" key:up draw list:focused:0@0 shot:f6-cursor"
    for k in j k a c p / r [ ] n shift-n g space 1 v m t s ? h l; do list+=" tap:$k"; done
    list+=" draw expect:mupu+preview notes:2:closed box:idle: list:focused:0@0 key:escape draw list:focused:@- key:escape draw box:focused: list:idle:@-"
    list+=" key:h key:i key:up draw box:focused:hi list:idle:@- key:cmd-a key:backspace key:up draw list:focused:0,1@0"
    run --notes list 0 "$list quit"
    picked="$zoom click:note:0 draw list:focused:0@0 click:note:1:cmd list:focused:0,1@1 click:note:1:cmd list:focused:0@1"
    picked+=" click:note:0:shift list:focused:0,1@0 click:note:1:shift list:focused:1@1 click:note:0 draw list:focused:0@0 shot:f6-picked"
    picked+=" key:enter wait:800 draw box:focused:check+the+outbox+after+a+409 notes:1:closed said:Moved+1+note+to+mupu’s+composer. list:idle:0@0 shot:f6-handed"
    run --notes picked 1 "$picked quit" "$zoom notes:1:closed box:idle:check+the+outbox+after+a+409 quit"
    keyed="$up key:up key:backspace draw notes:2:closed said:again+to+delete+1+note shot:f6-armed key:down key:up key:backspace draw notes:2:closed"
    keyed+=" key:backspace wait:800 draw notes:1:closed said:Deleted+1+note. list:focused:0@0 key:e draw notes:1:focused:ask+it+to+split+this"
    keyed+=" key:cmd-a key:backspace key:o key:k key:enter wait:800 draw notes:1:closed list:focused:0@0 said:Saved. shot:f6-edited key:cmd-c draw said:Copied+1+note."
    run --notes keyed 2 "$keyed quit"
    armed="$up key:up key:backspace draw said:again+to+delete+1+note key:cmd-c draw said:Copied+1+note. key:backspace draw said:again+to+delete"
    armed+=" tap:x draw said:Copied+1+note. key:backspace draw said:again+to+delete notes:2:closed key:escape draw notes:2:closed"
    armed+=" click:note:0 click:note:1:cmd click:note:1:cmd draw list:focused:0@1 key:e draw notes:2:focused:ask+it+to+split+this"
    run --notes armed 0 "$armed quit"
    grep -q 'platform: would copy "from mupu.s transcript:\\n> the reducer owns\\n> every mutation\\n\\nok"' "$home/keyed.log" || { echo "check-notes: keyed: not copied"; exit 1; }
    echo "check-notes: ok (empty strip hidden, editor keys type and never send, refused saves keep the editor, edit and delete by click, type-to-capture at the selection (saved with its quote, esc keeps nothing and gives the keys back, a click elsewhere closes it, cmd-enter sends), a capture per agent, hand-off into the draft survives a relaunch, alt-enter queues, the list by key and click: move, select, hand off the chosen and land on the next, delete twice and any other key disarms, edit the cursor's note in place, copy, no other key fires there)"

# Alert scenarios (U6), each through `scripts/scenario.sh`, whose fake serve's `--turn` frames finish agents'
# turns while the app runs. A scripted run is test mode (`platform_mac::quiet`): nothing is posted, no
# badge set, no chord taken; the log says what would have been:
# lens    mupu's turn ends with the app on the lens: one notification for mupu, the badge goes to 1;
# looking zoomed on mupu and frontmost (`HERDER_NATIVE_FRONT=1`), mupu and chief-mihe end a turn in one
#         frame: only chief-mihe is notified;
# burst   two frames 0.3 s apart: one summary for both;
# alone   risk-framework-gezu, in no space, ends a turn: notified as "· no space", the badge counts it;
#         its click opens it alone (shot u6-no-space), where the transcript, composer and notes work,
#         esc is the lens again, and no space is written.
# A blank script (set, so automation) is refused with exit 2 before the app opens.
check-alerts:
    #!/usr/bin/env bash
    . scripts/scenario.sh check-alerts
    run() { # NAME FRONT SCRIPT TURNS
        HERDER_NATIVE_FRONT=$2 scenario "$1" "$4" "$3"
        grep -q "turn:" "$home/$1.fake" || { echo "check-alerts: $1: no turn was sent"; exit 1; }
        notified=$(grep "would notify" "$home/$1.log" || true)
    }
    want() { # NAME WHAT PATTERN
        echo "$notified" | grep -q "$3" || { echo "check-alerts: $1: $2"; exit 1; }
    }
    once() { # NAME
        [ "$(echo "$notified" | grep -c .)" = 1 ] || { echo "check-alerts: $1: not exactly one notification"; exit 1; }
    }
    for blank in "" " "; do # set but blank: refused before the app opens, so nothing reaches the OS
        status=0
        HERDER_NATIVE_SCRIPT="$blank" ./target/release/herder-native >"$home/blank.log" 2>&1 || status=$?
        [ $status = 2 ] && ! grep -q "platform:" "$home/blank.log" || { echo "check-alerts: blank script ran (exit $status)"; exit 1; }
    done
    run lens 0 "wait:5500 quit" "--turn mupu"
    want lens "mupu not notified" "would notify agent:mupu: mupu · "
    once lens
    grep -q "platform: badge 1" "$home/lens.log" || { echo "check-alerts: lens: no badge 1"; exit 1; }
    grep -q "platform: would register ctrl-alt-cmd-h" "$home/lens.log" || { echo "check-alerts: lens: chord not skipped"; exit 1; }
    run looking 1 "wait:1500 key:enter wait:400 key:] wait:600 draw expect:mupu wait:3500 quit" "--turn mupu,chief-mihe"
    want looking "chief-mihe not notified" "would notify agent:chief-mihe"
    once looking
    run burst 0 "wait:6000 quit" "--turn mupu --turn support-mifa"
    want burst "no summary" "would notify space:.*2 agents need you"
    once burst
    alone="summon:agent:risk-framework-gezu wait:1500 draw expect:risk-framework-gezu+preview notes:0:closed"
    alone+=" key:/ draw key:h key:i draw box:focused:hi key:alt-enter wait:800 draw box:focused: notes:1:closed"
    run alone 0 "wait:5500 $alone shot:u6-no-space key:escape draw box:idle: key:escape wait:400 draw expect: quit" "--turn risk-framework-gezu"
    want alone "no notice for the agent in no space" "would notify agent:risk-framework-gezu: risk-framework-gezu · no space / your turn"
    once alone
    grep -q "platform: badge 1" "$home/alone.log" || { echo "check-alerts: alone: not badged"; exit 1; }
    seen alone "state notes:" 1
    seen alone "state spaces" 0
    badged() { # NAME N: the last badge shown
        [ "$(grep "platform: badge" "$home/$1.log" | tail -1)" = "platform: badge $2" ] || { echo "check-alerts: $1: badge not $2"; exit 1; }
    }
    run shared 0 "wait:4500 draw header:·+1+need+you quit" "--share mupu --turn mupu"
    badged shared 1
    # The turn lands after the dwell's second (RM): the tail is read by then.
    run tail 1 "wait:1500 key:enter wait:400 key:] wait:600 draw expect:mupu draw wait:3000 draw wait:1500 draw header:·+0+need+you quit" "--turn-at 5 --turn mupu --block mupu"
    grep -q "block: mupu" "$home/tail.fake" && [ -z "$notified" ] || { echo "check-alerts: tail: notified or no block"; exit 1; }
    ! grep -q "platform: badge [1-9]" "$home/tail.log" || { echo "check-alerts: tail: badged"; exit 1; }
    # Scrolled off the bottom by a key, what lands counts again. (A turn landing before the next frame
    # is views::tests' a_scroll_key_leaves_the_tail_before_the_next_render: frames come here meanwhile.)
    run scrolled 1 "wait:1500 key:enter wait:400 key:] wait:600 draw expect:mupu draw key:g wait:3500 header:·+1+need+you quit" "--turn mupu"
    [ -z "$notified" ] || { echo "check-alerts: scrolled: notified"; exit 1; }
    badged scrolled 1
    echo "check-alerts: ok (a turn notifies once and badges, the agent in view is never notified, a burst is one summary, an agent in no space alerts and opens alone, an agent in two spaces counts once, what lands on a watched tail is seen and counts once scrolled off it, no chord taken)"

# Mouse (F4), through `scripts/scenario.sh`: a click on a card selects it, a double-click zooms in, a click
# on a tab shows that agent and a click on `lens ›` zooms out, also from inside the composer and the notes
# editor (focus leaves them for the zoom); the cards' text reads (`limit=12`) reach the
# fake serve. Card 1 is `slack` (mupu, support-mifa) in the fixtures' lens order.
check-mouse:
    #!/usr/bin/env bash
    . scripts/scenario.sh check-mouse
    clicks="click:card:1 draw selected:slack click:card2:1 wait:400 draw expect:mupu"
    clicks+=" click:tab:1 draw expect:support-mifa click:crumb wait:400 draw expect:"
    scenario clicks "" "wait:1500 draw shot:f4-lens $clicks quit"
    # From inside the composer and the notes editor: a tab or `lens ›` click leaves the box for the zoom.
    zoom="wait:1500 click:card2:1 wait:400 draw expect:mupu"
    boxed="$zoom key:/ draw box:focused: click:tab:1 draw expect:support-mifa box:idle: click:tab:0 wait:600 draw expect:mupu"
    boxed+=" key:/ draw box:focused: click:crumb wait:400 draw expect: box:idle:"
    scenario boxed "" "$boxed quit"
    noted="$zoom key:a draw notes:0:focused: click:tab:1 draw expect:support-mifa notes:0:closed click:tab:0 wait:600"
    noted+=" draw key:a draw notes:0:focused: click:crumb wait:400 draw expect: notes:0:closed"
    scenario noted "" "$noted quit"
    grep -q "GET /api/agents/mupu/entries?limit=12 " "$home/clicks.fake" || { echo "check-mouse: no card read for mupu"; exit 1; }
    # Links by a real pointer (G1; `point:` sends move, down and up through the window), 1400×900: at
    # grill-confirm-lubo's tail, in its last answer and in its latest card the mention `kono` opens confirm-fresh-kono
    # as a preview; in riko, the `Pull 453` URL is opened
    # (logged, never done, in a scripted run) and the path `submit.rs` is resolved.
    lubo="wait:1500 summon:agent:grill-confirm-lubo wait:1500 draw draw"
    kono="wait:400 draw expect:confirm-fresh-kono+preview"
    HERDER_NATIVE_WINDOW=1400x900 scenario links "" "$lubo point:44,527 $kono quit" "$lubo point:43,672 $kono quit" \
        "wait:1500 summon:agent:riko wait:1500 draw key:g wait:800 draw key:g wait:800 draw find:Pull+453 wait:300 draw point:40,116 wait:200 point:100,142 wait:400 draw quit"
    grep -q "platform: would open https://github.com/infinex-xyz/boomerang/pull/453" "$home/links.log" || { echo "check-mouse: the URL was not opened"; exit 1; }
    seen links "GET /api/resolve?q=submit.rs" 1
    # After selecting text by a drag (one across the URL itself), one click on each link opens it once:
    # a click with a frame between press and release, and a fast one with none (a tap; `transcript::replay`).
    # The drags open nothing.
    riko="wait:1500 summon:agent:riko wait:1500 draw key:g wait:800 draw key:g wait:800 draw"
    pull="$riko find:Pull+453 wait:300 draw draw"
    HERDER_NATIVE_WINDOW=1400x900 scenario selected "" \
        "$pull drag:60,208,400,208 wait:200 draw drag:40,116,400,116 wait:200 draw point:40,116 wait:300 draw drag:60,208,400,208 wait:200 draw fast:40,116 wait:300 draw drag:60,208,400,208 wait:200 draw fast:100,142 wait:400 draw quit"
    HERDER_NATIVE_WINDOW=1400x900 scenario named "" \
        "$riko find:asked+chief+mihe wait:300 draw draw drag:60,208,400,208 wait:200 draw fast:120,158 wait:400 draw expect:fees-program-design-lifo+preview quit"
    opened=$(grep -c "platform: would open https://github.com/infinex-xyz/boomerang/pull/453" "$home/selected.log" || true)
    [ "$opened" = 2 ] || { echo "check-mouse: after a selection the URL opened $opened times, expected 2"; exit 1; }
    seen selected "GET /api/resolve?q=submit.rs" 1
    echo "check-mouse: ok (click selects, double-click zooms in, a tab click switches agent, lens › zooms out, both from the composer and the notes editor too, cards read their tails; real clicks on a mention in an answer and in a card open its preview, a URL opens and a path resolves, each once, also right after selecting text, and a drag opens nothing)"

# Activity runs (F2), through `scripts/scenario.sh`: zoomed on mupu, both recorded pages group into web's 19 rows
# and 9 runs (`testdata/runs-web.json`); `o` opens the lowest run on screen (at the tail, the last one) and
# closes it again; scrolled to the top, `o` opens a run there. Shot: f2-runs (the last run open). Jump-to-bottom
# (A1) is hidden at the tail, shows scrolled up, and a click on it follows the tail again. A3: in the open run a
# click opens the first tool to its input and output and closes it (shot: a3-member). The wheel (wheel-fix): a
# mouse's lines and a trackpad's pixels over the lens, then up from the watched tail (it leaves it, as the
# owner's crash did), over the scrollbar and sideways.
check-runs:
    #!/usr/bin/env bash
    . scripts/scenario.sh check-runs
    zoom="wait:1500 key:enter wait:400 key:] wait:600 draw expect:mupu wait:1500 draw"
    rows() { echo "rows:19+rows,+9+runs,+$1+open"; }
    tools() { echo "tools:$1+open,+$2+with+output"; }
    lens="wheel:700,400,l,0,-3 draw wheel:700,400,p,0,40 draw"
    wheel="wait:200 draw wheel:700,400,l,0,3 draw jump:shown click:jump draw jump:hidden wait:200 draw wheel:700,400,p,0,40 draw jump:shown wheel:1395,400,l,0,-3 draw wheel:700,400,l,2,0 draw"
    scenario runs "" "wait:1500 $lens $zoom $(rows 0) jump:hidden key:o draw $(rows 1) shot:f2-runs $(tools 0 0) click:member draw $(tools 1 1) shot:a3-member click:member draw $(tools 0 0) key:o draw $(rows 0) key:g draw jump:shown key:o draw $(rows 1) click:jump draw jump:hidden $wheel quit"
    echo "check-runs: ok (mupu in web's 19 rows and 9 runs, o opens and closes the lowest run, at the tail and scrolled up; a click opens a member to its input and output and closes it; the wheel in lines and pixels over the lens and up from the tail; jump-to-bottom shows only scrolled up, and a click on it follows the tail again)"

# A2 entries: the last answer's status chip opens and closes by click, then its internal note; mupu
# with two queued messages (shots: a2-status, a2-note).
check-entries:
    #!/usr/bin/env bash
    . scripts/scenario.sh check-entries
    zoom="wait:1500 key:enter wait:400 key:] wait:600 draw expect:mupu wait:1500 draw"
    parts() { echo "parts:$1+status,+$2+notes"; }
    scenario entries "--queued mupu" "$zoom $(parts 0 0) click:status draw $(parts 1 0) shot:a2-status click:status draw $(parts 0 0) find:Internal( wait:300 draw click:internal draw $(parts 0 1) shot:a2-note click:internal draw $(parts 0 0) quit"
    echo "check-entries: ok (mupu's last cut status chip opens and closes by click, its internal note too; queued box in the shots)"

# The dock in the zoom (DK2), through `scripts/scenario.sh` (fake serve, own HOME); in slack (mupu,
# support-mifa): an alt-click on a mention opens it beside, in a new group to the right; a mention opened in
# that group replaces its preview, and a double-click on the tab pins it (one members write); a real drag
# moves a member's tab to the other group; tab, cmd-2 and alt-left step the focused group, alt-enter
# maximizes it and back, and after a click on the transcript's text the next key still acts, in and out
# (G2: the text's element goes with the layout, and focus returns to the panel); cmd-w closes the pinned
# tab (it leaves the space: the second write), and a click on a preview's × closes it (no write). A
# relaunch on the same HOME opens the dock as it was left.
check-dock:
    #!/usr/bin/env bash
    . scripts/scenario.sh check-dock
    slack="wait:1500 key:enter wait:400 draw key:] wait:600 draw"
    scenario dock "" "$slack dock:[mupu*]+support-mifa beside:herder-agent:conductor-line wait:800 draw dock:mupu*+support-mifa+|+[conductor-line*~] shot:dk2-split point:1000,360 wait:300 draw key:alt-enter wait:300 draw dock:max+mupu*+support-mifa+|+[conductor-line*~] key:alt-enter wait:300 draw dock:mupu*+support-mifa+|+[conductor-line*~] point:1000,360 wait:300 draw key:alt-enter wait:300 draw point:1000,360 wait:300 draw key:alt-enter wait:300 draw dock:mupu*+support-mifa+|+[conductor-line*~] key:alt-enter wait:300 draw dock:max+mupu*+support-mifa+|+[conductor-line*~] key:alt-enter wait:300 draw dock:mupu*+support-mifa+|+[conductor-line*~] link:herder-agent:grill-confirm-lubo wait:800 draw dock:mupu*+support-mifa+|+[grill-confirm-lubo*~] click:pin:2 wait:300 draw dock:mupu*+support-mifa+|+[grill-confirm-lubo*] drag:154,42,1120,42 wait:300 draw dock:mupu*+|+grill-confirm-lubo+[support-mifa*] key:tab draw dock:mupu*+|+[grill-confirm-lubo*]+support-mifa key:cmd-2 draw dock:mupu*+|+grill-confirm-lubo+[support-mifa*] key:alt-left draw dock:mupu*+|+[grill-confirm-lubo*]+support-mifa key:alt-enter draw dock:max+mupu*+|+[grill-confirm-lubo*]+support-mifa key:alt-enter draw dock:mupu*+|+[grill-confirm-lubo*]+support-mifa key:cmd-w wait:300 draw dock:mupu*+|+[support-mifa*] link:herder-agent:conductor-line wait:600 draw dock:mupu*+|+support-mifa+[conductor-line*~] click:close:2 wait:300 draw dock:mupu*+|+[support-mifa*] wait:600 quit" "$slack dock:[mupu*]+|+support-mifa* quit"
    seen dock "state spaces.members" 2
    seen dock "message to" 0
    # Ten tabs in half a split (S2): chief crowded by the fake serve's --share, a preview opened beside.
    # Real clicks at 1416 wide: +N on the left group's strip, its last item (the tab scrolled out of
    # view) shows it; the group's □ maximizes, the □ of the maximized group restores.
    crowd="--share mupu,support-mifa,swap-bench-mora,fees-program-design-lifo,telegram-review-mire,orch-lega,conductor-line,e2e-cli-lipo,api-gateway-luko"
    ten="mupu+support-mifa+swap-bench-mora+fees-program-design-lifo+telegram-review-mire+orch-lega+conductor-line+e2e-cli-lipo"
    HERDER_NATIVE_WINDOW=1416x600 scenario crowd "$crowd" "wait:1500 key:enter wait:800 draw beside:herder-agent:grill-confirm-lubo wait:800 draw draw dock:chief-mihe*+$ten+api-gateway-luko+|+[grill-confirm-lubo*~] shot:s2-split point:666,41 wait:400 draw draw shot:s2-menu point:570,204 wait:400 draw draw dock:chief-mihe+$ten+[api-gateway-luko*]+|+grill-confirm-lubo*~ shot:s2-picked point:693,41 wait:400 draw draw dock:max+chief-mihe+$ten+[api-gateway-luko*]+|+grill-confirm-lubo*~ shot:s2-max point:1401,41 wait:400 draw draw dock:chief-mihe+$ten+[api-gateway-luko*]+|+grill-confirm-lubo*~ quit"
    echo "check-dock: ok (alt-click opens beside, a preview replaces the group's and a double-click pins it, a real drag moves a tab across, tab keys step the focused group, alt-enter maximizes and the keys act after it with focus left on the text, in and out, cmd-w closes and unpins, a click on × closes a preview, a relaunch restores the dock; ten tabs in half a split scroll, +N shows one out of view, the □ maximizes and restores)"

# Path clicks (G3), through `scripts/scenario.sh` (the fake serve answers `/api/resolve` from
# testdata/resolve.json): zoomed on mupu (cwd /home/ubuntu/slack-eyes), a path in two worktrees offers both,
# focused; the zoom's keys (`p` `j` `o`) do nothing under it; down then enter opens the second, a click on a fresh offer's first opens it, esc closes one
# opening nothing (the zoom stays); a real click on riko's `submit.rs` offers its two under the pointer; a path also in mupu's own root, ranked first by the serve, opens there at once, and a single match
# opens at once, its root with a space kept as one argument. Each open is VS Code's CLI argv, logged.
check-paths:
    #!/usr/bin/env bash
    . scripts/scenario.sh check-paths
    zoom="wait:1500 summon:agent:mupu wait:1500 draw draw expect:mupu"
    two="link:herder-path:src/views/paths.rs:9 wait:500 draw draw"
    picked="$two paths:focused:2@0 key:down draw paths:focused:2@1 tap:p tap:j tap:o draw paths:focused:2@1 shot:g3-paths key:enter draw paths:none"
    clicked="$two paths:focused:2@0 click:path:0 draw paths:none"
    closed="$two paths:focused:2@0 key:escape draw paths:none expect:mupu"
    single="link:herder-path:lib/own.rs wait:500 draw paths:none link:herder-path:notes.md:3 wait:500 draw paths:none"
    scenario paths "" "$zoom $picked $clicked $closed $single quit"
    # By a real pointer: riko's `submit.rs` (check-mouse's links, 1400×900) offers two, under the click.
    riko="wait:1500 summon:agent:riko wait:1500 draw key:g wait:800 draw key:g wait:800 draw find:Pull+453 wait:300 draw"
    HERDER_NATIVE_WINDOW=1400x900 scenario pointed "" "$riko wait:1000 draw draw point:100,142 wait:500 draw draw paths:focused:2@0 shot:g3-paths-pointed key:escape draw paths:none quit"
    # Each open is two calls of the code CLI (G3b): the root as a window's folder, then the file in it.
    code() { grep -cF "platform: would run code $1" "$home/paths.log" || true; }
    opens() {
        [ "$(code "[\"--folder-uri\", \"vscode-remote://ssh-remote+superset$1\"]")" = 1 ] &&
        [ "$(code "[\"-r\", \"--remote\", \"ssh-remote+superset\", \"-g\", \"$2\"]")" = 1 ] &&
        grep -A1 -F "vscode-remote://ssh-remote+superset$1\"]" "$home/paths.log" | grep -qF "\"-g\", \"$2\"]"
    }
    wt="/tools/herder/native/src/views/paths.rs:9"
    opens /home/ubuntu/wt/native-b "/home/ubuntu/wt/native-b$wt" || { echo "check-paths: enter did not open the second"; exit 1; }
    opens /home/ubuntu/wt/native-a "/home/ubuntu/wt/native-a$wt" || { echo "check-paths: the click did not open the first"; exit 1; }
    opens /home/ubuntu/slack-eyes /home/ubuntu/slack-eyes/lib/own.rs || { echo "check-paths: the agent's own root did not open"; exit 1; }
    opens "/home/ubuntu/my%20repo" "/home/ubuntu/my repo/docs/notes.md:3" || { echo "check-paths: the single match did not open"; exit 1; }
    opened=$(grep -c "platform: would run code" "$home/paths.log" || true)
    [ "$opened" = 8 ] || { echo "check-paths: $opened code calls, expected 8 (two per open)"; exit 1; }
    seen paths "GET /api/resolve?q=" 5
    seen paths "state notes" 0
    [ "$(grep -cE "tap [pjo]: handled false" "$home/paths.log")" = 3 ] || { echo "check-paths: a zoom key fired under the choices"; exit 1; }
    seen pointed "GET /api/resolve?q=submit.rs" 1
    echo "check-paths: ok (an ambiguous path offers its matches focused, down/enter and a click open one, the zoom's keys do nothing under them, esc closes; the agent's own root and a single match open at once; a real click offers under the pointer; each open is two code CLI calls, the folder then the file)"

# Read markers (RM), through `scripts/scenario.sh`: the fake serve's `read.markers` answers 404 until
# written. Nothing is posted to it before that first pull, then the board's agents are seeded weakly
# (version 1). In the back, mupu's turn badges and web reading it (`--read`: a row, then a
# `state-changed` nudge) clears the badge before its notification is due. Zoomed on mupu, frontmost at
# its tail, the dwell posts one readThrough (a time and a position), and alt-u posts it unread.
check-read:
    #!/usr/bin/env bash
    . scripts/scenario.sh check-read
    posts() { # NAME PATTERN: the read.markers POSTs with a row matching PATTERN
        grep "state read.markers" "$home/$1.fake" | grep -cE "$2" || true
    }
    HERDER_NATIVE_FRONT=0 scenario remote "--turn mupu --read mupu" "wait:5000 draw header:·+0+need+you quit"
    get=$(grep -n "GET /api/state/read.markers" "$home/remote.fake" | head -1 | cut -d: -f1)
    post=$(grep -n "state read.markers" "$home/remote.fake" | head -1 | cut -d: -f1)
    [ -n "$get" ] && [ -n "$post" ] && [ "$get" -lt "$post" ] || { echo "check-read: remote: a POST before the first pull"; exit 1; }
    [ "$(posts remote '"updated":1,"writeID"')" = 1 ] || { echo "check-read: remote: no weak seed"; exit 1; }
    seen remote "read: mupu" 1
    grep -q "platform: badge 1" "$home/remote.log" || { echo "check-read: remote: mupu's turn never badged"; exit 1; }
    [ "$(grep "platform: badge" "$home/remote.log" | tail -1)" = "platform: badge 0" ] || { echo "check-read: remote: web's read left the badge"; exit 1; }
    ! grep -q "would notify" "$home/remote.log" || { echo "check-read: remote: notified though read on web"; exit 1; }
    zoom="wait:1500 key:enter wait:400 key:] wait:600 draw expect:mupu"
    HERDER_NATIVE_FRONT=1 scenario dwell "" "$zoom wait:1500 draw header:·+0+need+you key:alt-u wait:400 draw header:·+1+need+you quit"
    row='"key":"mupu","value":\{"turn":[0-9]+,"pos":'
    read="$row"'\{[^}]*\},"at":[1-9][0-9]*,"unread":false'
    [ "$(posts dwell "$read")" = 1 ] || { echo "check-read: dwell: not one readThrough with a position for mupu"; exit 1; }
    [ "$(posts dwell "$row"'(null|\{[^}]*\}),"at":[0-9]+,"unread":true')" = 1 ] || { echo "check-read: dwell: alt-u posted no unread"; exit 1; }
    seen dwell "message to" 0
    echo "check-read: ok (no POST before the first pull, then weak seeds; web's read clears mupu's badge before its notification; the dwell posts one readThrough with its position; alt-u posts unread)"

# Build target/herder native.app (ad-hoc signed; notifications need a bundle id). Never launched here:
# the owner opens it, or runs `just install`.
bundle:
    scripts/bundle.sh

# Copy the bundle into ~/Applications, replacing an older copy. Only on the owner's say-so; automation
# never runs it.
install: bundle
    mkdir -p "$HOME/Applications"
    rsync -a --delete "target/herder native.app/" "$HOME/Applications/herder native.app/"

# Re-record testdata/ from the live serve (read-only GETs, staged, scrubbed, then published).
record:
    testdata/record.sh

# Page one whole transcript into testdata/big/ (gitignored) for perf runs, e.g. `just fetch-big riko`.
fetch-big agent:
    testdata/record.sh --full {{agent}}

# Lines per source file, for the DONE report and the line budgets.
lines:
    @wc -l src/*.rs src/*/*.rs tests/*.rs | sort -n

# Cold start (U1): builds a fresh release (no `shots`, which adds GPUI test-support), then the first launch
# records snapshot.json and the second paints from it; fails unless the snapshot holds agents and the second
# launch painted from it. Read `first paint`, `live board applied` and `rss` in the metrics. A throwaway HOME
# under target/ keeps the owner's local state untouched; the app only reads the serve (no local edits, so
# nothing is posted). Screenshots: `just harness`.
coldstart script="wait:2500 rss quit": build
    #!/usr/bin/env sh
    set -eu
    home="$PWD/target/coldstart-home"
    state="$home/Library/Application Support/herder-native"
    mkdir -p "$state"
    rm -f "$state/prefs.json" "$state/outbox.json" "$state/snapshot.json"
    HOME="$home" HERDER_NATIVE_SCRIPT="wait:2500 quit" ./target/release/herder-native 2>/dev/null
    grep -q '"agent": "[^-"]' "$state/snapshot.json" || { echo "coldstart: the warm-up saved no board"; exit 1; }
    out=$(HOME="$home" HERDER_NATIVE_SCRIPT="{{script}}" ./target/release/herder-native 2>&1)
    echo "$out"
    echo "$out" | grep -q "first paint (snapshot)" || { echo "coldstart: did not paint from the snapshot"; exit 1; }
