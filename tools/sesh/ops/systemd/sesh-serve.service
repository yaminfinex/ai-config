# /etc/systemd/system/sesh-serve.service — installed by ops/bootstrap.sh.
# The store embeds tsnet: it joins the tailnet as its own node (`sesh`) with
# identity state under /var/lib/sesh/tsnet. The VM's tailscaled, quickd, and
# Caddy are untouched — no unit ordering against them, restarts independent.
[Unit]
Description=sesh store — transcript ingest + read surface (tsnet node "sesh")
Wants=network-online.target
After=network-online.target

[Service]
User=sesh
# TS_AUTHKEY handoff: read at the first start to join the tailnet; ignored
# once tsnet state exists. The file is root-only (0600) and optional (-).
EnvironmentFile=-/etc/sesh/serve.env
# --debug-addr serves net/http/pprof on loopback only (never the tailnet):
# from a shell on the VM, `curl -s localhost:8767/debug/pprof/heap > heap.pb`.
ExecStart=/usr/local/bin/sesh serve --tsnet --tsnet-hostname sesh --addr :8765 --surface-addr :8766 --debug-addr 127.0.0.1:8767 --data-dir /var/lib/sesh
# Memory ceiling. The VM (4 GB e2-medium) is shared with quickd and Caddy,
# and an uncapped sesh at 3.4 GB once took it down: the global OOM stalled
# journald and networkd, and the VM stayed off the network for six days. The
# Go runtime collects harder near GOMEMLIMIT; MemoryHigh makes the kernel
# reclaim from this unit before anything else; MemoryMax kills only sesh,
# and Restart=always brings it back.
Environment=GOMEMLIMIT=1200MiB
MemoryHigh=1500M
MemoryMax=1800M
Restart=always
RestartSec=2
# SIGTERM is the drain signal (in-flight PUTs finish or fail without false
# ACKs); give the drain time before systemd escalates to SIGKILL.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
